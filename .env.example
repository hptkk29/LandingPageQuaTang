# ── MISA AMIS CRM (Web-to-lead) — SERVER-ONLY, không dùng prefix NEXT_PUBLIC_ ──
# Bắt buộc: FORM_ID + COMPANY_CODE + FORM_KEY (thiếu → lead chỉ vào Google Sheet,
# log [MISA-FAIL] SKIPPED_CONFIG). Lấy từ mã nhúng form quà tặng trên MISA admin.
MISA_FORM_ID=
MISA_COMPANY_CODE=
MISA_FORM_KEY=
# Tuỳ chọn (có default hợp lý):
# MISA_ENDPOINT=https://amisapp.misa.vn/crm/gc/api/open/WebForm/savecollection
# MISA_ALLOW_URL=https://quatang.edu.vn
# MISA_REDIRECT_URL=https://quatang.edu.vn/thank-you

# Affiliate — tên field MISA cho "Mã số NV nhập dữ liệu" (người giới thiệu).
# Để RỖNG cho tới khi form quà tặng trên MISA đã được thêm field này
# (rỗng = không gửi field, không bao giờ gửi giá trị giả — FR-B08).
MISA_AFF_FIELD_NAME=
# Tên field MISA chứa "Nguồn gốc Leads" — cấu hình được vì mỗi form map một kiểu
# (form quà tặng dùng field `FacebookID`, KHÔNG phải `LeadSourceID`).
MISA_AFF_LEAD_SOURCE_FIELD=
# Giá trị "Nguồn gốc Leads" cho lead affiliate.
# Phải set CẢ HAI biến trên+dưới thì mới gửi; thiếu một cái = bỏ qua field này.
MISA_AFF_LEAD_SOURCE_ID=

# ── Google Apps Script Web App — nhận lead backup, push vào Google Sheet ──
# GOOGLE_SCRIPT_URL là tên mới (server-only); NEXT_PUBLIC_GOOGLE_SCRIPT_URL cũ
# vẫn được đọc fallback trong 1 release.
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=

# ── Affiliate — kho mã link (Pha 1: Google Sheet "AffLinks"; Pha 4: satarobo) ──
# AFF_STORE=sheet | satarobo (mặc định sheet)
AFF_STORE=sheet
# Web App URL + secret của Apps Script AffLinks (docs/apps-script-aff-links.gs)
AFF_SHEET_API_URL=
AFF_SHEET_SECRET=

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Site URL (production)
NEXT_PUBLIC_SITE_URL=https://quatang.edu.vn

# Contact info
NEXT_PUBLIC_HOTLINE=0818823720
NEXT_PUBLIC_ZALO_OA=

# ══ Landing cờ vua (covua.quatang.edu.vn — route /covua) ══
# Lead cờ vua KHÔNG đẩy MISA (quyết định 16/08) — chỉ đi 2 đường trong
# /api/lead-covua: Google Sheet cờ vua + satarobo.vn ingest.

# Apps Script Web App RIÊNG cho sheet cờ vua (docs/apps-script-lead-covua.gs).
# Secret trùng với Script Property WEBHOOK_SECRET của script đó.
COVUA_SHEET_WEBHOOK_URL=
COVUA_SHEET_SECRET=

# Hotline + Zalo OA hiển thị trên trang covua
NEXT_PUBLIC_COVUA_HOTLINE=
NEXT_PUBLIC_COVUA_ZALO_URL=

# satarobo.vn ingest — CẢ BA đều server-only, không NEXT_PUBLIC_.
# Để trống cả 3 → landing vẫn chạy đủ, Sheet ghi sataroboStatus=failed.
# SATAROBO_INGEST_URL=https://satarobo.vn/api/public/leads/ingest
SATAROBO_INGEST_URL=
SATAROBO_INGEST_API_KEY=
SATAROBO_INGEST_SECRET=
