# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — chặn RỘNG mọi biến thể rồi mở ngoại lệ cho file mẫu.
# Lý do: `.env*.local` cũ KHÔNG match `.env` trần lẫn `.env.development`,
# mà Next.js nạp cả hai → secret có thể lọt vào repo (repo này PUBLIC).
.env
.env.*
!.env.example
.env.backup
*.bak
*.backup
*.key

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/
*.swp

# OS
Thumbs.db
.DS_Store

# UI/UX Pro Max cache
.uipro-cache/

# Profile Chrome của công cụ chụp màn hình (~100MB, chứa Login Data/History/
# Web Data). Repo PUBLIC nên tuyệt đối không để `git add .` cuốn theo.
.shots/

# Python bytecode (from UI/UX Pro Max scripts)
__pycache__/
*.pyc


.vercel

# Impeccable (design linter, cài bằng `npx impeccable install`).
# Binary theo nền tảng nặng ~17MB và chỉ chạy được trên windows-x64 —
# tải lại bằng `npx impeccable update`, không commit.
.claude/skills/impeccable/scripts/bin/
# Cache của hook thì bỏ qua, nhưng config.json là quyết định CHUNG của team
# (rule nào được tắt và vì sao) — phải đi theo repo.
.impeccable/*
!.impeccable/config.json
